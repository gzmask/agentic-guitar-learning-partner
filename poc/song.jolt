#!/usr/bin/env jolt
;; Fly Me to the Moon — Bart Howard. One 32-bar chorus, 64 BPM, two minutes.
;; Install: brew install jolt-lang/jolt/jolt csound
;; Play:    jolt poc/song.jolt            (low volume first; Ctrl+C stops)
;; Render:  jolt poc/song.jolt /tmp/song.wav   (no live audio)
;; Notes transposed F -> C, ties merged, from:
;; https://github.com/red-jackets-jazzband/website/blob/fa5d9123ad3ecc5a9c597967b9d15e3826beec45/static/songs/fly_me_to_the_moon.abc

(ns song
  (:require
    [clojure.java.shell :refer [sh]]
    [clojure.string :as str]))


;; Sixteenth-note ticks: onset, length, root MIDI, third, fifth, seventh.
(def harmony
  [[0 16 57 3 7 10]
   [16 16 50 3 7 10]
   [32 16 55 4 7 10]
   [48 8 48 4 7 11]
   [56 8 48 4 7 10]
   [64 16 53 4 7 11]
   [80 16 47 3 6 10]
   [96 16 52 4 7 10]
   [112 8 57 3 7 10]
   [120 8 57 4 7 10]
   [128 16 50 3 7 10]
   [144 16 55 4 7 10]
   [160 16 48 4 7 11]
   [176 8 52 3 7 10]
   [184 8 57 4 7 10]
   [192 16 50 3 7 10]
   [208 16 55 4 7 10]
   [224 8 50 3 7 10]
   [232 8 48 4 7 11]
   [240 8 47 3 6 10]
   [248 8 52 4 7 10]
   [256 16 57 3 7 10]
   [272 16 50 3 7 10]
   [288 16 55 4 7 10]
   [304 8 48 4 7 11]
   [312 8 48 4 7 10]
   [320 16 53 4 7 11]
   [336 16 47 3 6 10]
   [352 16 52 4 7 10]
   [368 8 57 3 7 10]
   [376 8 57 4 7 10]
   [384 16 50 3 7 10]
   [400 16 55 4 7 10]
   [416 16 52 3 7 10]
   [432 16 57 4 7 10]
   [448 16 50 3 7 10]
   [464 16 55 4 7 10]
   [480 16 48 4 7 11]
   [496 16 48 4 7 11]])


;; Onset, length, melody MIDI. Gaps are rests; ties are single notes.
(def melody
  [[0 4 72] [4 4 71] [8 2 69] [10 6 67]
   [16 6 65] [22 2 67] [24 4 69] [28 4 72]
   [32 4 71] [36 4 69] [40 2 67] [42 6 65]
   [48 15 64] [64 4 69] [68 4 67] [72 2 65]
   [74 6 64] [80 6 62] [86 2 64] [88 4 65]
   [92 4 69] [96 4 68] [100 4 65] [104 2 64]
   [106 6 62] [112 11 60] [124 4 61] [128 2 62]
   [130 4 69] [134 13 69] [148 8 72] [156 4 71]
   [160 27 67] [188 4 59] [192 2 60] [194 4 65]
   [198 13 65] [212 8 69] [220 4 67] [224 8 65]
   [232 23 64] [256 4 72] [260 4 71] [264 2 69]
   [266 6 67] [272 6 65] [278 2 67] [280 4 69]
   [284 4 72] [288 4 71] [292 4 69] [296 2 67]
   [298 6 65] [304 15 64] [320 4 69] [324 4 67]
   [328 2 65] [330 6 64] [336 4 62] [340 4 64]
   [344 4 65] [348 4 69] [352 4 68] [356 4 65]
   [360 2 64] [362 6 62] [368 11 60] [380 4 61]
   [384 2 62] [386 4 69] [390 13 69] [404 8 72]
   [412 4 71] [416 27 76] [444 4 72] [448 2 74]
   [450 4 69] [454 13 69] [468 8 71] [476 4 74]
   [480 32 72]])


(def orchestra
  "sr = 48000
ksmps = 64
nchnls = 2
0dbfs = 1

; score: i 2 (root/strum) or i 6 (lead) start duration freq amplitude pan
; Roots and lead share the selected electric tone, but remain separate tracks.
instr 2, 6
  ; Fit attack/release inside short lead notes, even at 240 BPM.
  iattack = min(0.006, p3 * 0.1)
  idecay = min(0.05, p3 * 0.15)
  irelease = min(0.09, p3 * 0.25)
  iplateau = p3 - iattack - idecay - irelease
  aenv linseg 0, iattack, 1, idecay, 0.85, iplateau, 0.8, irelease, 0
  astr pluck p5, p4, p4, 0, 1
  ; sustained tone layer (fundamental + octave) reinforces the string
  ; delayed vibrato: depth ramps in ~0.35s after the note, ~5.5 Hz, +/-1.5%
  kvibdepth linseg 0, 0.35, 0, 0.25, 1
  kvib oscili kvibdepth * 0.015, 5.5
  kvfreq = p4 * (1 + kvib)
  asus1 oscili p5 * 0.5, kvfreq
  asus2 oscili p5 * 0.22, kvfreq * 2
  amix = astr + asus1 + asus2
  ; soft overdrive: harmonics, compression and sustain (amp-driven)
  idrive = 30
  adrv = tanh(amix * idrive) * p5 * 1.2
  ; tame the fizz without killing the bite
  adrv tone adrv, 2800
  ; Keep the melody as a quiet guide (~14 dB cut), preserving its drive tone.
  ivoicegain = (p1 == 6 ? 0.2 : 1)
  adrv = adrv * ivoicegain
  aleft = adrv * aenv * sqrt((1 - p6) / 2)
  aright = adrv * aenv * sqrt((1 + p6) / 2)
  outs aleft, aright
endin

; score: i 4 start duration freq amplitude pan
; Right-hand tapping voice: percussive attack, short decay, electric drive,
; no vibrato and no long sustain plateau -- the melodic counterpart to the
; ringing root on instr 2.
instr 4
  aenv linseg 0, 0.004, 1, 0.03, 0.5, max(0.01, p3 - 0.1), 0.18, 0.066, 0
  astr pluck p5, p4, p4, 0, 1
  abody oscili p5 * 0.3, p4
  amix = astr + abody
  adrv = tanh(amix * 24) * p5 * 1.1
  adrv tone adrv, 3200
  ; Bring chord-defining thirds/sevenths forward by ~6 dB, after overdrive.
  adrv = adrv * 2
  aleft = adrv * aenv * sqrt((1 - p6) / 2)
  aright = adrv * aenv * sqrt((1 + p6) / 2)
  outs aleft, aright
endin

; A restrained kick: low-frequency sweeps on the and of beats 1 and 3.
; score: i 5 start 0.35 amplitude
instr 5
  aenv expseg 1, 0.35, 0.0001
  kfreq expseg 145, 0.09, 52, 0.26, 46
  akick oscili p4 * aenv, kfreq
  outs akick, akick
endin

instr 99
  exitnow
endin
")


(def tick (/ 15.0 64.0))
(def amplitude 0.18)


(defn hz
  [midi]
  (* 440.0 (Math/pow 2.0 (/ (- midi 69) 12.0))))


(defn note
  [instrument start duration & fields]
  (str "i " instrument " " start " " duration
       " " (str/join " " fields) "\n"))


(def score
  (str
    ;; Sustained roots, with chord-tone taps on the remaining eighths.
    (apply str
           (for [[at length root third fifth seventh] harmony
                 i (range (quot length 2))
                 :let [pitch (+ root (nth [0 third fifth seventh 12 seventh fifth third] i))
                       start (* (+ at (* i 2)) tick)]]
             (if (zero? i)
               (note 2 start (* length tick 0.98) (hz pitch) (/ amplitude 2.2) 0)
               (note 4 start (* (min 2.6 (- length (* i 2))) tick)
                     (hz pitch) (/ amplitude 4.0) (- 0.2 (* 0.06 i))))))
    ;; Syncopated kicks on the and of beats 1 and 3.
    (apply str
           (for [bar (range 32) [offset gain] [[2 0.6] [10 0.4]]]
             (note 5 (* (+ (* bar 16) offset) tick) 0.35 (* amplitude gain))))
    (apply str
           (for [[at length pitch] melody]
             (note 6 (* at tick) (* length tick) (hz pitch) (* amplitude 0.65) 0.3)))
    "i 99 120 0.01\nf 0 z\n"))


(when (> (count *command-line-args*) 1)
  (throw (ex-info "Usage: jolt poc/song.jolt [output.wav]" {})))


(let [output (first *command-line-args*)
      csd (str "<CsoundSynthesizer>\n<CsInstruments>\n" orchestra
               "</CsInstruments>\n<CsScore>\n" score
               "</CsScore>\n</CsoundSynthesizer>\n")]
  (println (if output (str "Rendering to " output)
               "Fly Me to the Moon — 64 BPM, two minutes. Ctrl+C stops."))
  (flush)
  ;; Foreground only. The score ends at 120s; alarm also caps wall time at 600s.
  ;; Pass the entire synth/score on stdin: no state, generated files or daemon.
  (let [{:keys [exit err]}
        (apply sh (concat ["/usr/bin/perl" "-e" "alarm 600; exec @ARGV or die $!"
                           "csound" "-d" "-m0"]
                          (if output ["-W" "-o" output] ["-odac"])
                          ["/dev/stdin" :in csd]))]
    (when-not (zero? exit)
      (binding [*out* *err*] (print err))
      (System/exit exit))))

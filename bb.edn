{:tasks
 {build {:doc "Compile Carp score generator"
         :task (shell "bb" "scripts/control.bb" "build")}
  play {:doc "Play a guitar pattern, chord, mode, root or finite progression"
        :task (apply shell "bb" "scripts/control.bb" "play" *command-line-args*)}
  stop {:doc "Terminate only this project's Csound process"
        :task (shell "bb" "scripts/control.bb" "stop")}
  status {:doc "Show whether this project's Csound process is alive"
          :task (shell "bb" "scripts/control.bb" "status")}
  test {:doc "Test generated scores and render a short offline WAV"
        :task (shell "bb" "scripts/test.bb")}}}

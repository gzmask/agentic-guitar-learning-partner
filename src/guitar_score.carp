(Project.config "title" "guitar-score")
(load "src/fly_me.carp")

; A short-lived Carp compiler target. It prints a Csound score and exits.
; No Carp or Csound REPL remains alive between commands.

(defn parse-int [text]
  (match (Int.from-string text)
    (Maybe.Just value) value
    (Maybe.Nothing) 0))

(defn parse-double [text]
  (match (Double.from-string text)
    (Maybe.Just value) value
    (Maybe.Nothing) 0.0))

(defn pitch-class [note]
  (cond
    (= note "c") 0
    (or (= note "c#") (= note "db")) 1
    (= note "d") 2
    (or (= note "d#") (= note "eb")) 3
    (= note "e") 4
    (= note "f") 5
    (or (= note "f#") (= note "gb")) 6
    (= note "g") 7
    (or (= note "g#") (= note "ab")) 8
    (= note "a") 9
    (or (= note "a#") (= note "bb")) 10
    (= note "b") 11
    0))

(defn midi-hz [midi]
  (* 440.0 (Double.pow 2.0 (/ (Double.from-int (- midi 69)) 12.0))))

(defn root-midi [root octave]
  (+ (* (+ octave 1) 12) (pitch-class root)))

(defn chord-intervals [quality]
  (cond
    (= quality "minor") [0 3 7 12 15]
    (= quality "major") [0 4 7 12 16]
    (= quality "power") [0 7 12 19 24]
    (= quality "minor7") [0 3 7 10 12]
    (= quality "major7") [0 4 7 11 12]
    (= quality "dominant7") [0 4 7 10 12]
    (= quality "sus2") [0 2 7 12 14]
    (= quality "sus4") [0 5 7 12 17]
    [0 3 7 12 15]))

(defn mode-intervals [mode]
  (cond
    (or (= mode "ionian") (= mode "major")) [0 4 7 11 12]
    (= mode "dorian") [0 3 7 9 12]
    (= mode "phrygian") [0 1 3 7 12]
    (= mode "lydian") [0 4 6 7 12]
    (= mode "mixolydian") [0 4 7 10 12]
    (or (= mode "aeolian") (= mode "minor")) [0 3 7 8 12]
    (= mode "locrian") [0 1 3 6 12]
    [0 3 7 8 12]))

(defn voicing-line [instrument root octave intervals bpm duration amplitude]
  (let [base (root-midi root octave)
        line (if (= instrument 1)
               (str* "i 1 0 -1 " bpm " " duration " " amplitude)
               (str* "i 3 0 -1 " amplitude))]
    (do
      (for [index 0 5]
        (let [frequency (midi-hz (+ base @(Array.unsafe-nth &intervals index)))]
          (set! line (str* &line " " frequency))))
      ; Csound itself exits at exactly ten minutes, even if strings are active.
      (str* &line "\ni 99 600 0.01\nf 0 z\n"))))

; Sustain the root at each chord change, including the half-bar changes.
; Tap the remaining eighths; release the last tap before the harmony changes.
(defn progression-chord-line [base intervals start chord-seconds note-step note-count amplitude]
  (let [pattern [0 1 2 3 4 3 2 1]
        root-length (* chord-seconds 0.98)
        line (String.copy "")]
    (do
      (for [index 0 note-count]
        (let [interval @(Array.unsafe-nth &intervals @(Array.unsafe-nth &pattern index))
              offset (* (Double.from-int index) note-step)
              frequency (midi-hz (+ base interval))
              note-length (min (* note-step 1.3) (- chord-seconds offset))
              note-line (if (= index 0)
                          (str* "i 2 " start " " root-length " " frequency
                                " " (/ amplitude 2.2) " 0.0\n")
                          (str* "i 4 " (+ start offset) " " note-length " " frequency
                                " " (/ amplitude 4.0)
                                " " (- 0.2 (* 0.06 (Double.from-int index))) "\n"))]
          (set! line (String.append &line &note-line))))
      line)))

(defn melody-score [tick-seconds amplitude]
  (let [notes (FlyMe.melody)
        line (String.copy "")]
    (do
      (for [index 0 (/ (Array.length &notes) 3)]
        (let [offset (* index 3)
              start (* (Double.from-int @(Array.unsafe-nth &notes offset)) tick-seconds)
              duration (* (Double.from-int @(Array.unsafe-nth &notes (+ offset 1))) tick-seconds)
              frequency (midi-hz @(Array.unsafe-nth &notes (+ offset 2)))
              note-line (str* "i 6 " start " " duration " " frequency
                              " " (* amplitude 0.65) " 0.3\n")]
          (set! line (String.append &line &note-line))))
      line)))

; One complete 32-bar chorus, not four repeats of the opening eight bars.
(defn progression-score [bpm amplitude]
  (let [tick-seconds (/ 15.0 bpm)
        bar-seconds (* tick-seconds 16.0)
        end-seconds (* 32.0 bar-seconds)
        harmony (FlyMe.harmony)
        score (String.copy "")]
    (do
      (for [index 0 (/ (Array.length &harmony) 6)]
        (let [offset (* index 6)
              at @(Array.unsafe-nth &harmony offset)
              start (* (Double.from-int at) tick-seconds)
              ticks @(Array.unsafe-nth &harmony (+ offset 1))
              base @(Array.unsafe-nth &harmony (+ offset 2))
              third @(Array.unsafe-nth &harmony (+ offset 3))
              fifth @(Array.unsafe-nth &harmony (+ offset 4))
              seventh @(Array.unsafe-nth &harmony (+ offset 5))
              intervals [0 third fifth seventh 12]
              chord-line (progression-chord-line base intervals start
                                                (* (Double.from-int ticks) tick-seconds)
                                                (* tick-seconds 2.0) (/ ticks 2) amplitude)
              ; Numeric cue fields reuse the exact pitches of the chord.
              ; Csound formats the name when this event actually runs.
              cue-line (str* "i 7 " start " 0.001 " (+ (/ at 16) 1) " "
                             (+ (/ (mod at 16) 4) 1) " " base " "
                             third " " fifth " " seventh "\n")]
          (set! score (str* &score chord-line cue-line))))
      (for [bar 0 32]
        (let [start (* (Double.from-int bar) bar-seconds)
              ; Leave chord changes clear: kicks on the and of beats 1 and 3.
              kick-line (str* "i 5 " (+ start (* tick-seconds 2.0)) " 0.35 " (* amplitude 0.6)
                              "\ni 5 " (+ start (* tick-seconds 10.0)) " 0.35 " (* amplitude 0.4) "\n")]
          (set! score (String.append &score &kick-line))))
      (str* &score (melody-score tick-seconds amplitude)
            "i 99 " end-seconds " 0.01\nf 0 z\n"))))

(defn main []
  (if (/= (StaticArray.length &System.args) 8)
    (IO.errorln "Usage: guitar-score <guitar|chord|mode|root|progression> <root> <quality> <octave> <bpm> <envelope-seconds> <amplitude>")
    (let [kind @(StaticArray.unsafe-nth &System.args 1)
          root @(StaticArray.unsafe-nth &System.args 2)
          quality @(StaticArray.unsafe-nth &System.args 3)
          octave (parse-int (StaticArray.unsafe-nth &System.args 4))
          bpm (parse-double (StaticArray.unsafe-nth &System.args 5))
          duration (parse-double (StaticArray.unsafe-nth &System.args 6))
          amplitude (parse-double (StaticArray.unsafe-nth &System.args 7))]
      (cond
        (= &kind "progression")
        (IO.println &(progression-score bpm amplitude))
        (= &kind "guitar")
        (let [base (root-midi &root octave)
              ; A minor uses A2 E3 A3 C4 E4, the usual five-string voicing.
              intervals (if (= &quality "minor") [0 7 12 15 19] (chord-intervals &quality))]
          (IO.println &(voicing-line 1 &root octave intervals bpm duration amplitude)))
        (= &kind "chord")
        (IO.println &(voicing-line 3 &root octave (chord-intervals &quality) bpm duration amplitude))
        (= &kind "mode")
        (IO.println &(voicing-line 3 &root octave (mode-intervals &quality) bpm duration amplitude))
        (= &kind "root")
        (IO.println &(voicing-line 3 &root octave [0 0 12 12 24] bpm duration amplitude))
        (IO.errorln "Unknown practice kind")))))

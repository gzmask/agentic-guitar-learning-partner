; Fly Me to the Moon -- Bart Howard. One complete 32-bar chorus in C.
; Note/rhythm reference, transposed from F to C, with tied notes merged:
; https://github.com/red-jackets-jazzband/website/blob/fa5d9123ad3ecc5a9c597967b9d15e3826beec45/static/songs/fly_me_to_the_moon.abc
; Sixteenth-note ticks preserve short phrase rests without rounding to eighths.
; This is score data only: no runtime downloads, samples, or lyrics.
(defmodule FlyMe
  ; Flat sextuplets: onset, length, root MIDI, third, fifth, seventh.
  ; Intervals are semitones above the root; one bar is 16 ticks.
  (defn harmony []
